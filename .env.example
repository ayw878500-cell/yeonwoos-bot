BITGET_API_KEY=your_key
BITGET_API_SECRET=your_secret
BITGET_API_PASSPHRASE=your_passphrase

BITGET_BASE_URL=https://api.bitget.com
BITGET_SYMBOL=BTCUSDT
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT

# 요청값 기본 반영
LEVERAGE=10
ENTRY_FRACTION=1.0
RISK_PER_TRADE=0.01
STOP_LOSS_PCT=0.01
RISK_REWARD_RATIO=2.0

# 보조지표/신호 설정
# EMA Cross
FAST_MA=9
SLOW_MA=21
# 최소 진입 조건 개수(2개 이상일 때만 진입)
MIN_ENTRY_CONDITIONS=2
# 캔들 주기 (예: 5m, 15m, 1H)
CANDLE_GRANULARITY=5m
# 매일 리포트 전송 시각(UTC 기준, 0=한국 09:00)
REPORT_HOUR_UTC=0

# 일일 운용 규칙
MAX_DAILY_STOPLOSS=3
DAILY_TARGET_PCT=0.1
MIN_ORDER_MARGIN_USDT=5
SIGNAL_COOLDOWN_SEC=120

# 포지션 관리 고급 설정
# +2R 도달 시 반익절 후 나머지는 본절(진입가)로 이동
PARTIAL_TAKE_PROFIT_RR=2.0
# 손실 구간에서 추세 재정렬 시 추가진입(물타기) 트리거
ADD_ON_LOSS_TRIGGER_PCT=0.006
ADD_ON_LOSS_FRACTION=0.25
MAX_ADD_COUNT=1
# 손실 시 실시간 자가 피드백 알림
LOSS_FEEDBACK_TRIGGER_PCT=0.004
FEEDBACK_INTERVAL_SEC=300

# 실전모드
DRY_RUN=false
LIVE_CONFIRM=I_UNDERSTAND_LIVE_TRADING
ARMED_TRADING=true
LOOP_INTERVAL_SEC=5

# 텔레그램 (둘 다 입력해야 알림 전송)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
